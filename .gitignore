# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# === Ambientes virtuais ===
venv/
.venv/
env/
.env

# === Jupyter / Colab ===
.ipynb_checkpoints/
*.ipynb_checkpoints

# === Dados e modelos (não versionar arquivos pesados) ===
