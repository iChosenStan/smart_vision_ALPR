datasets/processed/*
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep

models/pretrained/*
models/checkpoints/*
!models/pretrained/.gitkeep
!models/checkpoints/.gitkeep

# === Outputs gerados ===
outputs/logs/*
outputs/predictions/*
outputs/reports/*
!outputs/logs/.gitkeep
!outputs/predictions/.gitkeep
!outputs/reports/.gitkeep

# === Pesos e artefatos comuns ===
*.pt
*.pth
*.onnx
*.h5
*.pb
*.weights

